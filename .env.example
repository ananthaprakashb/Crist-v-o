# Independent semantic verifier
GEMINI_API_KEY=

# Optional override. Defaults to gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash

# Render Workflows + Web Service shared state. Use the internal Render Key Value URL in production.
REDIS_URL=

# Optional when triggering deployed workflow tasks from code.
RENDER_API_KEY=

# Optional local web-service overrides.
PORT=3001
HOST=0.0.0.0

# Optional local source-pipeline paths.
# SOURCE_STATE_DIR=data/source-snapshots
# SOURCE_FEED_PATH=public/source-intelligence.json
